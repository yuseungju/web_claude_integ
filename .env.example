# 로컬에서 쓸 키. 이 파일을 .env 로 복사해서 값을 채운다.
#   copy .env.example .env     (Windows)
#
# .env 는 .gitignore 에 있어 커밋되지 않는다. 키를 여기 말고
# 명령줄이나 코드에 적지 말 것 — 셸 기록에 그대로 남는다.

# ── 숙소 ──────────────────────────────────────────────
# 국내 — 한국관광공사 TourAPI (공공데이터포털에서 발급, 무료)
#   data.go.kr → "한국관광공사 국문 관광정보" → 활용신청 → 시스템유형 "일반"
#   Encoding / Decoding 두 종류가 나오는데, 400 이 나면 다른 쪽으로 바꿔본다.
TOURAPI_KEY=

# 해외 — LiteAPI (Nuitée Connect). 샌드박스 키는 sand_ 로 시작한다.
#   헤더 X-API-Key 로 보낸다. 운영 키와 샌드박스 키가 따로 있다.
LITEAPI_KEY=

# ── 기존 기능 (SAP·에이전트) ─────────────────────────
# 모델 호출. 없으면 AI 기능만 꺼지고 나머지는 정상 동작한다.
HERMES_URL=
PROXY_TOKEN=
